<?xml version="1.0" encoding="UTF-8"?>
<!-- Only the pages meant to be found. The quote page, the office and the admin
     console are deliberately absent: a sitemap is an invitation, and none of
     those three wants one. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://fenceflowapp.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
<!-- lead.html is deliberately NOT listed. It only works with a ?c=<company>
     token, and the bare URL was indexable: a stranger could land on it from a
     search, fill the form in and be told the link was invalid, losing their
     enquiry. The page now refuses to show the form without a token, and this
     entry would still be sending people to that refusal. -->
  <url>
    <loc>https://fenceflowapp.com/fence-solutions/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://fenceflowapp.com/privacy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://fenceflowapp.com/terms.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
