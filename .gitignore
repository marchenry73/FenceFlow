# Local configuration — contains SDK paths and API credentials.
local.properties

# Firebase config identifies your project and enables its quotas; keep it out
# of a public repository. Each developer downloads their own from the console.
app/google-services.json

# Release signing — losing or leaking these means losing control of the app.
*.jks
*.keystore
keystore.properties

# Build output
build/
app/build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class

# IDE
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Node (website tooling)
node_modules/

# Kotlin compiler scratch output, not source
.kotlin/

# Cloud backups contain customer personal data. Never commit them.
# The backup script also refuses to write inside this repo.
fenceflow-*/
*Backups/

# Scratch output from database probes -- never belongs in the repo.
*.probe.txt
o*.txt

# agent worktrees (tooling scratch, never source)
.claude/worktrees/

# Session scratch that collected in the repo root: one-off SQL handed to
# `db query`, its output, and build/test logs. Named by pattern rather than a
# blanket *.log so nothing real can hide behind this.
#
# Why bother: the rule before every commit here is to read `git status
# --porcelain` and account for EVERY file, because `git add -A` twice swept an
# agent's half-finished work into a commit and once pushed it live. Fifteen lines
# of scratch noise is what makes that rule easy to skip.
_tmp_q*.sql
_tmp_q*.out
_verify_q*.sql
live*.sql.err
live*.sql.out.json
reapply.log
t[0-9].log

# Build and regeneration logs. Redirected to a file on purpose -- never piped,
# because a pipeline returns the LAST command's status and a failed build then
# reports success. Read while they grow, byproducts afterwards.
#
# NAMED, not `*.log`, for the reason given above: a blanket pattern is where
# something real hides. An earlier version of this block did use `*.log` and
# `*.bak`, which quietly overrode that decision -- undone 2026-10-02.
build-[0-9]*.log
fixture-regen.log
unit-tests.log

# The backup scripts/patch-office-quote-email-recipient.mjs writes before it
# touches website/dashboard.html, so a bad run is recoverable. Not a
# deliverable, and named rather than globbed for the same reason.
dashboard.html.bak-office-recipient

# Deploy and publish logs, named rather than globbed (see the block above).
deploy-[0-9]*.log
publish-[0-9]*.log
