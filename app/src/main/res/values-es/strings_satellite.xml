<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- New strings introduced by: satellite tracing on the survey drawing
         screen, and the crew-invite outcome dialogs on the Employees screen.
         Kept out of strings.xml (which values-es/values-fr also carry, and
         a StringResourceSanityTest checks all three stay in lockstep) so
         this feature never has to touch either translation, and never has
         to touch a file every other screen also edits. -->

    <!-- Survey drawing screen: label shown above the canvas while satellite
         imagery is the background, alongside the existing "on grid" / "on
         photo" labels this sits next to. -->
    <string name="misc_survey_drawing_on_satellite">Dibujando sobre imágenes satelitales</string>

    <!-- The toggle that swaps the no-photo grid for satellite imagery. Only
         offered when there is no survey photo (see the office's calibration
         rule: satellite sets 20 px/ft only when there is nothing else to
         calibrate against). -->
    <string name="sat_toggle_label">Satélite</string>

    <!-- Shown while satellite is on but the phone has no connection. The
         grid still draws underneath (it always does, as the base layer) so
         tracing is never actually blocked; this just says why the imagery
         itself isn't there. -->
    <string name="sat_offline_note">No hay señal por ahora, así que se muestra la cuadrícula en lugar de la foto. Puedes seguir dibujando; la imagen vuelve a aparecer en cuanto el teléfono se reconecte.</string>

    <!-- Shown in LayersDialog once the grid has been zoomed out past what
         satellite imagery can fully cover at this job's own site latitude
         (SurveyViewModel.maxSatelliteExtentFt): the honest "here's where
         the photo runs out" instead of a silently cropped picture. %1$d is
         that distance in feet, computed fresh per job/latitude, never a
         fixed number. This is the common case, not a rare edge: the default
         400ft canvas already exceeds the fetch budget at most latitudes the
         moment someone zooms out once. -->
    <string name="sat_extent_note">La imagen satelital está completa hasta unos %1$d pies de ancho en esta zona. Más allá, es posible que falten partes de la imagen y se muestre la cuadrícula en su lugar.</string>

    <!-- Employees screen: outcome of inviting a newly-added crew member by
         email (invite-crew). -->
    <string name="emp_invite_sent_title">Invitación enviada por correo</string>
    <string name="emp_invite_emailed_body">Recibirán un correo con un enlace para unirse a tu equipo en FenceFlow.</string>

    <!-- No mail path was configured on the server side; invite-crew handed
         back a team code to pass along by hand instead. -->
    <string name="emp_invite_needs_code_title">No se pudo enviar por correo -- aquí tienes el código en su lugar</string>
    <string name="emp_invite_needs_code_fallback">Comparte este código con ellos para que puedan unirse a tu equipo.</string>
    <string name="emp_team_code_label">Código del equipo</string>
    <string name="emp_team_code_copied">Copiado.</string>

    <string name="emp_invite_failed_title">No se pudo enviar la invitación</string>
</resources>
